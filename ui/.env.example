# Base URL of your own API. Keep "/api" when the UI is served behind a reverse proxy
# that forwards /api to your Node.js backend. Use an absolute URL (e.g. http://localhost:3000/api)
# when the API lives on another origin (CORS must allow this origin).
VITE_API_BASE_URL=/api

# Optional bearer token added to every API request:
#   Authorization: Bearer <token>
VITE_API_TOKEN=

# Optional photo upload endpoint. Receives multipart/form-data with field "file".
# Response may be { "url": "https://..." } / { "downloadUrl": "..." } / { "download_url": "..." }
# or a plain URL string. Leave empty to disable the Upload photos action.
VITE_UPLOAD_URL=
